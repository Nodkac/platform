# Terraform state can contain secrets in plaintext — never commit it.
# (Phase 5+. A team would use remote state in S3 with DynamoDB locking.)
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/.terraform.lock.hcl
*.tfvars
*.tfvars.json

# Credentials — never
*.pem
*.key
.env
credentials.csv
.aws/

# Build output
/app-bin
app/app-bin

# macOS
.DS_Store
